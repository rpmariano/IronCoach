#!/bin/sh
# =============================================================================
# IronHealth — Pre-Push Quality Gate
# =============================================================================
# Este hook corre automaticamente antes de cada `git push`.
# Se qualquer verificação falhar, o push é bloqueado.
#
# Fluxo:
#   1. Correr testes (Vitest)
#   2. Verificar build (Vite)
#   3. Se houver alterações em supabase/, avisar
#   4. Revisão real por IA do diff (claude -p) — só bloqueia com veredito
#      🔴 recebido com sucesso; falha de infraestrutura nunca bloqueia.
#
# Para saltar o hook em emergência: git push --no-verify
# =============================================================================

set -e

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

echo ""
echo "${CYAN}╔══════════════════════════════════════════════════════════╗${NC}"
echo "${CYAN}║${NC}  ${BOLD}🎯 IronHealth Quality Orchestrator — Pre-Push Gate${NC}     ${CYAN}║${NC}"
echo "${CYAN}╚══════════════════════════════════════════════════════════╝${NC}"
echo ""

# Guardar directório de trabalho
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Determinar o que mudou vs remote
REMOTE="$1"
URL="$2"

# Ler os refs que estão a ser pushed
CHANGED_FILES=""
BASE_SHA=""
LOCAL_SHA=""
while read local_ref local_sha remote_ref remote_sha; do
    LOCAL_SHA="$local_sha"
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # Nova branch — comparar com master/main
        BASE_SHA=$(git merge-base HEAD origin/master 2>/dev/null || git merge-base HEAD origin/main 2>/dev/null || echo "HEAD~10")
    else
        BASE_SHA="$remote_sha"
    fi
    CHANGED_FILES=$(git diff --name-only "$BASE_SHA" "$LOCAL_SHA" 2>/dev/null || echo "")
done

VERDICT="APROVADO"
WARNINGS=""
ERRORS=""

# ─────────────────────────────────────────────────────────────
# 1. TEST ENGINEER — Correr Vitest
# ─────────────────────────────────────────────────────────────
echo "${BLUE}🧪 [1/4] Test Engineer — A correr testes...${NC}"
echo ""

cd "$REPO_ROOT"
if npx vitest run 2>&1; then
    echo ""
    echo "${GREEN}   ✅ Testes passaram${NC}"
else
    echo ""
    echo "${RED}   ❌ Testes falharam!${NC}"
    ERRORS="${ERRORS}\n  - Testes Vitest falharam"
    VERDICT="BLOQUEADO"
fi
echo ""

# ─────────────────────────────────────────────────────────────
# 2. PWA AUDITOR (parcial) — Verificar build
# ─────────────────────────────────────────────────────────────
echo "${BLUE}📱 [2/4] PWA Auditor — A verificar build...${NC}"
echo ""

cd "$REPO_ROOT"
if npm run build 2>&1; then
    echo ""
    echo "${GREEN}   ✅ Build bem-sucedido${NC}"
    # Limpar dist/ gerado pelo check (não queremos poluir o working tree)
    rm -rf dist/
else
    echo ""
    echo "${RED}   ❌ Build falhou!${NC}"
    ERRORS="${ERRORS}\n  - Build Vite falhou"
    VERDICT="BLOQUEADO"
fi
echo ""

# ─────────────────────────────────────────────────────────────
# 3. SUPABASE GUARDIAN — Verificar alterações ao backend
# ─────────────────────────────────────────────────────────────
echo "${BLUE}🔐 [3/4] Supabase Guardian — A verificar alterações ao backend...${NC}"
echo ""

SUPABASE_CHANGES=$(echo "$CHANGED_FILES" | grep -E '(^supabase/|\.sql$|src/lib/supabase|src/store/)' || true)

if [ -n "$SUPABASE_CHANGES" ]; then
    echo "${YELLOW}   ⚠️  Detetadas alterações ao backend Supabase:${NC}"
    echo "$SUPABASE_CHANGES" | while read -r file; do
        echo "${YELLOW}      → $file${NC}"
    done
    echo ""
    echo "${YELLOW}   Lembra-te: NÃO existe BD de desenvolvimento separada.${NC}"
    echo "${YELLOW}   Todas as alterações afetam PRODUÇÃO diretamente.${NC}"
    WARNINGS="${WARNINGS}\n  - Alterações Supabase detetadas (revê RLS e migrações)"
    if [ "$VERDICT" = "APROVADO" ]; then
        VERDICT="APROVADO COM AVISOS"
    fi
else
    echo "${GREEN}   ⏭️  Sem alterações ao backend — saltado${NC}"
fi
echo ""

# ─────────────────────────────────────────────────────────────
# 4. REVISÃO POR IA — claude -p sobre o diff real
# ─────────────────────────────────────────────────────────────
# Só corre se testes e build já tiverem passado — não vale a pena gastar uma
# chamada real ao modelo sobre código que já sabemos estar partido.
#
# Corre sem a ferramenta Bash (bloqueada por política de conta em modo
# --dangerously-skip-permissions/headless) — o diff é calculado aqui, em
# shell, e passado como texto no prompt. O modelo pode Read/Grep/Glob
# ficheiros do repositório para mais contexto (ex.: specs/PRD.md), mas não
# corre comandos.
#
# Falha de infraestrutura (sem `claude` no PATH, sem rede, timeout, erro da
# API) NUNCA bloqueia o push — só um veredito 🔴 recebido com sucesso o faz.
# Os testes e o build continuam a ser o gate real; isto é uma camada extra.
echo "${BLUE}🤖 [4/4] Revisão por IA — a analisar o diff...${NC}"
echo ""

if [ "$VERDICT" = "BLOQUEADO" ]; then
    echo "${YELLOW}   ⏭️  Saltado — testes ou build já falharam${NC}"
elif ! command -v claude >/dev/null 2>&1; then
    echo "${YELLOW}   ⏭️  Saltado — comando 'claude' não encontrado nesta máquina${NC}"
else
    DIFF_TEXT=$(git diff "$BASE_SHA" "$LOCAL_SHA" 2>/dev/null | head -c 40000)

    if [ -z "$DIFF_TEXT" ]; then
        echo "${GREEN}   ⏭️  Sem diferenças de código a rever — saltado${NC}"
    else
        AI_PROMPT="Revê este diff antes de ir para produção (repositório IronHealth, specs/PRD.md é a spec — podes lê-la para contexto). Aponta só problemas reais: bugs, desvio da spec, más práticas. Termina sempre a resposta com uma linha exatamente neste formato: VEREDITO: <emoji> <motivo curto numa frase>
onde <emoji> é 🟢 (sem problemas), 🟡 (avisos não-bloqueantes) ou 🔴 (bug real ou desvio grave da spec).

DIFF:
${DIFF_TEXT}"

        # O prompt vai por stdin, não como argumento — um diff grande excede
        # o limite de tamanho da linha de comandos no Windows ("Argument
        # list too long"), que já aconteceu ao testar isto.
        AI_OUTPUT=$(cd "$REPO_ROOT" && printf '%s' "$AI_PROMPT" | timeout 90 claude -p --dangerously-skip-permissions 2>&1) && AI_EXIT=0 || AI_EXIT=$?

        if [ "$AI_EXIT" -ne 0 ]; then
            echo "${YELLOW}   ⚠️  Revisão por IA falhou (infraestrutura) — não bloqueia, só aviso${NC}"
            echo "${YELLOW}   $(echo "$AI_OUTPUT" | head -3)${NC}"
            WARNINGS="${WARNINGS}\n  - Revisão por IA não conseguiu correr (ver output acima)"
            if [ "$VERDICT" = "APROVADO" ]; then
                VERDICT="APROVADO COM AVISOS"
            fi
        else
            echo "$AI_OUTPUT" | grep -v "^VEREDITO:" || true
            echo ""
            AI_LINE=$(echo "$AI_OUTPUT" | grep "^VEREDITO:" | tail -1)
            echo "${BOLD}   $AI_LINE${NC}"

            if echo "$AI_LINE" | grep -q "🔴"; then
                ERRORS="${ERRORS}\n  - Revisão por IA: ${AI_LINE}"
                VERDICT="BLOQUEADO"
            elif echo "$AI_LINE" | grep -q "🟡"; then
                WARNINGS="${WARNINGS}\n  - Revisão por IA: ${AI_LINE}"
                if [ "$VERDICT" = "APROVADO" ]; then
                    VERDICT="APROVADO COM AVISOS"
                fi
            fi
        fi
    fi
fi
echo ""

# ─────────────────────────────────────────────────────────────
# RELATÓRIO FINAL
# ─────────────────────────────────────────────────────────────
echo "${CYAN}══════════════════════════════════════════════════════════${NC}"

if [ "$VERDICT" = "BLOQUEADO" ]; then
    echo "${RED}${BOLD}  🔴 BLOQUEADO — Push cancelado${NC}"
    echo "${RED}  Erros encontrados:${NC}"
    echo -e "${RED}${ERRORS}${NC}"
    if [ -n "$WARNINGS" ]; then
        echo "${YELLOW}  Avisos:${NC}"
        echo -e "${YELLOW}${WARNINGS}${NC}"
    fi
    echo ""
    echo "${RED}  Corrige os erros acima e tenta novamente.${NC}"
    echo "${RED}  Em emergência: git push --no-verify${NC}"
    echo "${CYAN}══════════════════════════════════════════════════════════${NC}"
    echo ""
    exit 1
elif [ "$VERDICT" = "APROVADO COM AVISOS" ]; then
    echo "${YELLOW}${BOLD}  🟡 APROVADO COM AVISOS — Push permitido${NC}"
    echo "${YELLOW}  Avisos:${NC}"
    echo -e "${YELLOW}${WARNINGS}${NC}"
    echo "${CYAN}══════════════════════════════════════════════════════════${NC}"
    echo ""
    exit 0
else
    echo "${GREEN}${BOLD}  🟢 APROVADO — Push permitido${NC}"
    echo "${CYAN}══════════════════════════════════════════════════════════${NC}"
    echo ""
    exit 0
fi
